# ==============================================================================
# TicketPlatform - Environment Configuration Template
# Copy this file to .env.local for local development, or configure in Vercel/production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (safe for browser client requests)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (CRITICAL: Server-side only, bypasses RLS for system operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Application Domain
# ------------------------------------------------------------------------------
# Canonical URL of the web application (used for QR code links and pass resolution)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Cryptographic Security & Gate Verifiers
# ------------------------------------------------------------------------------
# High-entropy secret key for HMAC SHA-256 verifier session tokens (min 32 characters)
# Generate with: openssl rand -hex 32
VERIFIER_JWT_SECRET=replace_with_a_secure_minimum_32_character_random_secret_key

# ------------------------------------------------------------------------------
# 4. Email Delivery (Resend API)
# ------------------------------------------------------------------------------
# Resend API Key for sending ticket pass confirmation and invitation emails
RESEND_API_KEY=re_your_resend_api_key

# Verified sender address
EMAIL_FROM="Ticket Platform <tickets@yourdomain.com>"
